#!/bin/sh
# Refuse direct pushes to main. main only changes via a staging -> main PR on GitHub.
# Installed automatically by `npm install` (see "prepare" script in package.json).
# Emergency bypass (don't): git push --no-verify

while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "" >&2
      echo "  ✗ Direct push to 'main' blocked." >&2
      echo "    Open a PR from 'staging' into 'main' on GitHub instead." >&2
      echo "" >&2
      exit 1
      ;;
  esac
done
exit 0
