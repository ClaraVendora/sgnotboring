PORT=3001
# Comma-separated list of allowed browser origins
WEB_ORIGIN=http://localhost:3000

# Local Supabase (from `npm run db:start`). When the API runs inside docker-compose,
# use http://host.docker.internal:54321 instead of 127.0.0.1.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=paste-anon-key-from-supabase-status
# Server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-from-supabase-status

# Gemini (Google AI Studio). Free-tier limits are per project, so use a separate AI Studio
# project + key for local, staging and production. Used by POST /ask and the enrich job.
GEMINI_API_KEY=paste-key-from-aistudio.google.com
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: used once when GEMINI_MODEL is overloaded/times out (defaults to gemini-3.5-flash-lite)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
