PORT=3012
# On Railway set HOST=:: so the private network can reach this service.

# Local Supabase (from `npm run db:start`). Inside docker-compose this is overridden with
# http://host.docker.internal:54321.
SUPABASE_URL=http://127.0.0.1:54321
# Only used to verify login tokens with Supabase Auth
SUPABASE_ANON_KEY=paste-anon-key-from-supabase-status

# Gemini (Google AI Studio). Free-tier limits are per project, so use a separate AI Studio
# project + key for local, staging and production.
GEMINI_API_KEY=paste-key-from-aistudio.google.com
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: used once when GEMINI_MODEL is overloaded/times out (defaults to gemini-3.5-flash-lite)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# The Places service (Railway: http://${{places.RAILWAY_PRIVATE_DOMAIN}}:${{places.PORT}})
PLACES_URL=http://localhost:3011
# The Accounts service (Railway: http://${{accounts.RAILWAY_PRIVATE_DOMAIN}}:${{accounts.PORT}})
ACCOUNTS_URL=http://localhost:3013
