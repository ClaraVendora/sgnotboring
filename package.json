{
  "name": "sgnotboring",
  "private": true,
  "version": "0.1.0",
  "description": "Singapore Discovery Hub (MVP) \u2014 AI-curated food & experiences for young Singaporeans",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration new",
    "db:push:staging": "supabase link --project-ref pyaqltngppzgcodojita && supabase db push",
    "db:push:prod": "supabase link --project-ref pnzjujwgvycdriwomwew && supabase db push"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.4.2",
  "devDependencies": {
    "supabase": "^2.117.0",
    "turbo": "^2.10.12"
  }
}
